<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The Ombudsman site sends an incomplete certificate chain, so the
         PDF viewer can't verify it on its own. We bundle the site's
         certificate here and trust it ALONGSIDE the normal system roots,
         so PDFs load. Everything else still uses the system roots only. -->
    <domain-config>
        <domain includeSubdomains="true">ombudsmanpunjab.gov.pk</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/ombudsman" />
        </trust-anchors>
    </domain-config>

    <!-- Everything else: the normal system roots, HTTPS only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>